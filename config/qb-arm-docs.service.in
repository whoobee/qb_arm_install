[Unit]
Description=qBArm documentation server (http://<host>:8080)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
ExecStart=/usr/bin/python3 @DOCS@/server/qb_docs_server.py --port 8080 --pages @DOCS@/pages
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
