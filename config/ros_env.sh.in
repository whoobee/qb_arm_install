# ROS 2 environment for the qb_arm workspace - sourced from ~/.bashrc
# Generated by qb_arm_install/install.sh
source /opt/ros/jazzy/setup.bash

ROS2_WS="@WS@"
[ -f "$ROS2_WS/install/setup.bash" ] && source "$ROS2_WS/install/setup.bash"

export ROS_DOMAIN_ID=0
export RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Discovery Server ("master") runs locally as systemd service ros2-discovery.service
# on UDP 11811. Remote machines use ROS_DISCOVERY_SERVER=<this machine's IP>:11811
export ROS_DISCOVERY_SERVER="127.0.0.1:11811"
# Super client: CLI tools (ros2 topic list, etc.) see the whole graph
export ROS_SUPER_CLIENT=TRUE

source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash 2>/dev/null
alias cb='(cd "$ROS2_WS" && colcon build --symlink-install) && source "$ROS2_WS/install/setup.bash"'

# Azure Kinect DK (ceiling camera) only
alias kinect='ros2 launch qb_arm kinect.launch.py'
# Whole cell: Lite6 + MoveIt + RViz + ceiling Kinect (args: sim:=true, camera:=false, add_gripper:=true, robot_ip:=...)
alias qbarm='ros2 launch qb_arm bringup.launch.py'
