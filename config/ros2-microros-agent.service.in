[Unit]
Description=micro-ROS agent for the qB-AdaptiveGripper (ESP32 over Wi-Fi, UDP 8888)
After=network-online.target ros2-discovery.service
Wants=network-online.target ros2-discovery.service

[Service]
User=@USER@
ExecStart=/bin/bash -c 'source @WS@/ros_env.sh && exec ros2 run micro_ros_agent micro_ros_agent udp4 --port 8888'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
